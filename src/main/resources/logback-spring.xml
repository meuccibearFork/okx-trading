<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 定义日志存放路径 -->
    <property name="LOG_PATH" value="./logs"/>

    <!-- 定义日志输出格式 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"/>
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50}[%line] - %msg%n"/>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 所有日志文件输出 -->
    <appender name="ALL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/all/all.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 日志文件名格式，按小时滚动 -->
            <fileNamePattern>${LOG_PATH}/all/all.%d{yyyy-MM-dd-HH}.log</fileNamePattern>
            <!-- 日志文件保留天数，改为3天 -->
            <maxHistory>72</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <filter class="com.okx.trading.constant.log.AdminLogFilter">
            <!--可以修改成INFO，DEBUG等-->
            <level>DEBUG</level>
            <onMatch>NEUTRAL</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
    </appender>

    <!-- 错误日志文件输出 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error/error.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 日志文件名格式，按小时滚动 -->
            <fileNamePattern>${LOG_PATH}/error/error.%d{yyyy-MM-dd-HH}.log</fileNamePattern>
            <!-- 日志文件保留天数，改为3天 -->
            <maxHistory>72</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <!-- 只记录ERROR级别日志 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <filter class="com.okx.trading.constant.log.AdminLogFilter">
            <!--可以修改成INFO，DEBUG等-->
            <level>DEBUG</level>
            <onMatch>NEUTRAL</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
    </appender>

    <!-- API相关日志文件输出 -->
    <appender name="API_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/api/api.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 日志文件名格式，按小时滚动 -->
            <fileNamePattern>${LOG_PATH}/api/api.%d{yyyy-MM-dd-HH}.log</fileNamePattern>
            <!-- 日志文件保留天数，改为3天 -->
            <maxHistory>72</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <filter class="com.okx.trading.constant.log.AdminLogFilter">
            <!--可以修改成INFO，DEBUG等-->
            <level>DEBUG</level>
            <onMatch>NEUTRAL</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
    </appender>

    <!--  wss日志  -->
    <appender name="WSS_MSG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/wss_message.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- 日志记录器的滚动策略，按日期，按大小记录 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/%d{yyyy-MM-dd}/wss_msg-%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <!--日志文件保留天数-->
            <maxHistory>3</maxHistory>
        </rollingPolicy>
    </appender>

    <!--  wss日志  -->
    <appender name="WSS_STRATEGY_MSG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/wss_strategy_message.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- 日志记录器的滚动策略，按日期，按大小记录 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/%d{yyyy-MM-dd}/wss_strategy_msg-%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <!--日志文件保留天数-->
            <maxHistory>3</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- OKX API相关日志 -->
    <logger name="com.okx.trading.service.impl.OkxMarketApiServiceImpl" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="API_FILE"/>
    </logger>

    <!-- WebSocket相关日志 -->
    <logger name="com.okx.trading.util.WebSocketUtil" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="API_FILE"/>
    </logger>

    <!-- K线缓存相关日志 -->
    <logger name="com.okx.trading.service.impl.KlineCacheServiceImpl" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- K线更新相关日志 -->
    <logger name="com.okx.trading.service.impl.KlineUpdateServiceImpl" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- K线清理相关日志 -->
    <logger name="com.okx.trading.service.impl.KlineCleanupServiceImpl" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- 控制器层日志 -->
    <logger name="com.okx.trading.controller" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- Spring框架日志 -->
    <logger name="org.springframework" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- Hibernate日志 -->
    <logger name="org.hibernate" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- Redis日志 -->
    <logger name="org.springframework.data.redis" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <logger name="wss.msg">
        <appender-ref ref="WSS_MSG"/>
    </logger>

    <logger name="wss.strategy.msg">
        <appender-ref ref="WSS_STRATEGY_MSG"/>
    </logger>

    <!-- 根日志配置 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
